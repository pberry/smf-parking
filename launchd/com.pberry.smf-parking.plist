<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pberry.smf-parking</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/pberry/src/smf-parking/.venv/bin/python</string>
        <string>-m</string>
        <string>smf_parking.poll</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/pberry/src/smf-parking</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Minute</key>
        <integer>5</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/pberry/src/smf-parking/data/launchd.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/pberry/src/smf-parking/data/launchd.log</string>
</dict>
</plist>
